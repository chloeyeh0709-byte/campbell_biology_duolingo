# Pooled connection string (e.g. Neon's "-pooler" endpoint), used by the app at runtime.
DATABASE_URL="postgresql://user:password@host-pooler:5432/dbname?sslmode=require&pgbouncer=true"
# Direct (unpooled) connection string, used only for `prisma migrate deploy`.
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
JWT_SECRET="replace-with-a-long-random-string"
